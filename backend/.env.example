# --- Database ---
# For PostgreSQL (recommended for production / client deployment):
# DATABASE_URL=postgresql+psycopg2://campus_user:campus_pass@localhost:5432/campus_resolve
#
# For quick local testing WITHOUT installing PostgreSQL, SQLite works out of the box:
DATABASE_URL=sqlite:///./campus_resolve.db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Uploads ---
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_MB=5

# --- CORS ---
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
